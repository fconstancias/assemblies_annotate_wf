# Nextflow runtime state and work directories -- huge, ephemeral, regeneratable via -resume
# against the real work/ dir which itself never belongs in git
work/
.nextflow/
.nextflow.log*
.nextflow.pid
*.trace.txt
report-*.html
timeline-*.html
dag-*.html

# Pipeline outputs -- large data products, not source, regeneratable by rerunning the
# documented commands (REPRODUCE.md) against the real upstream contigs-dbs
results/

# Real per-sample gene exports -- large FASTA/GFF3/GenBank data, regeneratable from the
# source anvi'o contigs-db via the exact commands in REPRODUCE.md section 5.
# NOTE: a pattern with a slash anywhere but the end (e.g. "gene_export/*.faa") anchors to
# the .gitignore's own directory -- it does NOT match a nested gene_export/ dir under a
# subdirectory (confirmed the hard way: single_assembly_production/gene_export/ wasn't
# covered until the leading **/ was added). Trailing **/ additionally needed to reach a
# subdirectory *inside* gene_export/ too (e.g. gene_export/subset/*.faa, one level past
# what **/gene_export/*.faa alone reaches) -- confirmed the same way, immediately after
# fixing the first half of this same pattern.
**/gene_export/**/*.faa
**/gene_export/**/*.fna
**/gene_export/**/*.gff3
**/gene_export/**/*.gbff

# Verbose run logs -- often multi-MB, not meaningful outside the run that produced them
*.log
logs/

# SLURM batch stdout/stderr and S3 sync-watcher internal state -- same category as *.log
# above, just a different extension/dir name
*.out
.s3_sync_state/

# anvi'o KEGG metabolism-estimate output -- large per-group data product, regeneratable via
# single_assembly_production/anvio_kegg/run_kofams_array.sh (or coassembly_production's
# equivalent) against the source contigs-db, same logic as the gene_export exclusions above
*_metabolism_modules.txt

# Anvi'o contigs-dbs -- binary SQLite data, regeneratable via anvi-gen-contigs-database
# (see REPRODUCE.md) or already sourced from BINNING/01_ANVIO_DBs/ outside this repo
*.db

# Large reference databases -- these live outside assembly_annotation_wf/ anyway
# (anvio_kegg_data/, dram2_databases/ are project-wide, not per-workflow) but excluded
# defensively in case anything gets built locally
*_data/
*_database/
*_databases/
