diff --git a/modules/nf-core/ampcombi2/parsetables/main.nf b/modules/nf-core/ampcombi2/parsetables/main.nf
index 3724703..408785e 100644
--- a/modules/nf-core/ampcombi2/parsetables/main.nf
+++ b/modules/nf-core/ampcombi2/parsetables/main.nf
@@ -30,12 +30,43 @@ process AMPCOMBI2_PARSETABLES {
     prefix = task.ext.prefix ?: "${meta.id}"
     def db_dir = opt_amp_db_dir ? "--amp_database_dir ${opt_amp_db_dir}" : ""
     def interpro = opt_interproscan ? "--interproscan_output ${opt_interproscan}" : ""
+    // gbk_input is legitimately absent for pre-annotated gff+protein input with no gbk file
+    // (funcscan's own workflow code treats gbk as optional - see assembly_annotation_wf's
+    // CLAUDE.md for the schema-side half of this same bug). ampcombi's own argparse rejects
+    // a bare, argument-less --gbk, and its Python validation (check_input.py's
+    // check_gbk_path()) also rejects an entirely omitted flag - it wants *some* value, either
+    // a real file or a directory containing one. When gbk_input is genuinely absent, generate
+    // a placeholder directory with a minimal-but-valid (Biopython-written, to guarantee
+    // round-trip parseability) empty GenBank record - enough to satisfy ampcombi's validation,
+    // though downstream steps needing real per-CDS content (e.g. AMPCOMBI2_CLUSTER's
+    // contig_id) still need genuine annotation, not this placeholder. When gbk_input *is*
+    // supplied (a real file, from our own gff3->gbk export - see CLAUDE.md), it's already a
+    // valid check_gbk_path() target as-is: pass it straight through, no placeholder dance -
+    // treating it as a directory to mkdir/ls into (the placeholder-only code path) crashed
+    // with "NotADirectoryError" the first time a real file was supplied.
+    def gbk_dir = gbk_input ?: "empty_gbk_placeholder"
+    def gbk_setup = gbk_input ? "" : """
+    if [ ! -e "${gbk_dir}" ]; then
+        mkdir -p ${gbk_dir}
+    fi
+    if ! ls ${gbk_dir}/*${prefix}*.gbff > /dev/null 2>&1; then
+        python3 -c "
+from Bio.Seq import Seq
+from Bio.SeqRecord import SeqRecord
+from Bio.SeqIO import write
+rec = SeqRecord(Seq('N'), id='${prefix}', name='${prefix}'[:15], description='placeholder - no real gbk for this sample')
+rec.annotations['molecule_type'] = 'DNA'
+write(rec, '${gbk_dir}/${prefix}.gbff', 'genbank')
+"
+    fi
+    """
 
     """
+    ${gbk_setup}
     ampcombi parse_tables \\
         --path_list '${amp_input.collect { file_path -> "${file_path}" }.join("' '")}' \\
         --faa ${faa_input} \\
-        --gbk ${gbk_input} \\
+        --gbk ${gbk_dir} \\
         --sample_list ${prefix} \\
         --amp_database ${opt_amp_db} \\
         ${db_dir} \\
