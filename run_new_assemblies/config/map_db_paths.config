// MAP v5.0.0 database paths under the shared /maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/.
//
// Hand-built rather than pasted from --download_dbs's own printed summary: that summary is
// generated in the pipeline's workflow.onComplete handler, which crashed on this run (see
// README.md "Monitoring / troubleshooting") because two of its ten DB-download processes hit
// upstream bugs and were force-ignored. All ten databases are nonetheless correctly present
// on disk (verified by listing scratch/mobilome_db/ directly) -- paths below match that
// verified layout exactly.
params {
    // Mobilome
    genomad_db                   = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/genomad/genomad_db_v1.9"
    checkv_db                    = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/checkV/checkv_db/checkv-db-v1.5"
    icefinder_macsyfinder_models = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/icefinder2/icf2_dbs/macsydata"
    // Fourth upstream gap: hmmscan needs the exact basename prefix of the pressed .h3*
    // index files. This DB's files are icescan.hmm.h3f/h3i/h3m/h3p (note the extra .hmm),
    // not icescan.h3*, so the path must include .hmm -- confirmed by listing
    // scratch/mobilome_db/icefinder2/icf2_dbs/icehmm/ directly (docs' own template path,
    // ".../icehmm/icescan", is wrong for this DB bundle and crashes HMMSCAN with
    // "HMM file icescan not found").
    icefinder_hmm_models         = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/icefinder2/icf2_dbs/icehmm/icescan.hmm"
    icefinder_prokka_uniprot_db  = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/icefinder2/icf2_dbs/icefinder_prokka_uniprot"

    // PATHOFACT2
    pathofact_models             = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/pathofact"
    virulencefactors_db          = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/virulence/VFDB_setB_pro.dmnd"
    ncbi_cdd                     = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/localcdsearch/database"

    // AMR
    // Fifth upstream bug, more serious: AMRFINDERPLUS_RUN's script does
    // `mv ${db} amrfinderdb` unconditionally. When the staged input's basename is ALREADY
    // literally "amrfinderdb" (exactly what MAP's own docs template names the directory --
    // "amrfinderplus_db = /path/to/dbs/amrfinderplus/amrfinderdb"), this becomes
    // `mv amrfinderdb amrfinderdb`: a self-move of a symlink-to-directory that exits 0 but
    // *deletes the symlink* (verified empirically: `ln -s realdir x; mv x x` leaves neither
    // `x` nor an error). amrfinder then fails with "directory ... not found: amrfinderdb".
    // Worked around by pointing this at a same-target symlink with a different basename
    // instead of the DB dir directly, so the mv is a real (non-colliding) rename.
    amrfinderplus_db             = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/amrfinderplus/amrfinderdb_data"
    deeparg_db                   = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/deeparg/db"
    // Third upstream gap: these three have no default anywhere in MAP (not even in its own
    // printed config template) yet are required -- null crashes AMR_ANNOTATION's DeepARG
    // report step ("A process input channel evaluates to null", amr_annotation/main.nf:126).
    // tool_version matches the pinned deeparg container tag (modules/nf-core/deeparg/
    // downloaddata/main.nf); model 'LS' = genes/proteins (vs 'SS' for raw reads), matching
    // our Prodigal-predicted-protein input; db_version is a free-form report label only, not
    // validated against the DB itself.
    deeparg_db_version            = 1
    deeparg_model                = "LS"
    deeparg_tool_version          = "1.0.4"
    // Sixth upstream gap: --download_dbs only runs RGI_DOWNLOADDB (raw card.json), never
    // RGI_CARDANNOTATION (the preprocessing step that builds card_database_v*.fasta /
    // ..._all.fasta). But AMR_ANNOTATION's logic for an EXTERNALLY-supplied --rgi_db skips
    // preprocessing entirely and assumes the directory IS already card_database_processed/
    // (the conditional that would auto-run RGI_CARDANNOTATION on a raw dir is commented out
    // in subworkflows/ebi-metagenomics/amr_annotation/main.nf). Left pointed at the raw
    // card_dir/, RGI_MAIN fails (`ls card_dir/card_database_*_all.fasta`: no such file).
    // Ran `rgi card_annotation -i card_dir/card.json` by hand via the cached RGI container
    // (matching RGI_CARDANNOTATION's own script exactly) and assembled the result into
    // card_database_processed/ below.
    rgi_db                       = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/rgi/card_database_processed"

    // BGC
    antismash_db                 = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/antismash/antismash_db"
    // SanntiS requires InterProScan; --download_dbs never touches IPS at all (fully manual,
    // ~100GB, no MAP-provided download helper -- confirmed absent from
    // subworkflows/local/download_databases.nf). Downloaded core IPS 5.76-107.0 by hand
    // (matches params.interproscan_db_version's own default) from
    // ftp.ebi.ac.uk/pub/software/unix/iprscan/5/5.76-107.0/ and extracted only `data/`.
    interproscan_db               = "/maps/projects/hansen_ol-AUDIT/scratch/mobilome_db/interproscan/interproscan_db"
    interproscan_db_version       = "5.76-107.0"
    // Licensed SignalP hook: MAP's patched container (microbiome-informatics/
    // interproscan:5.76-107.0_patch1) expects genuine SignalP 4.1 (Perl), NOT SignalP 6
    // (Python/PyTorch) -- confirmed correct after obtaining an actual SignalP 4.1g/Linux
    // license from DTU: the script itself hardcodes
    // `$ENV{SIGNALP} = '/usr/opt/www/pub/CBS/services/SignalP-4.1/signalp-4.1'`, and
    // main.nf's containerOptions specifically bind-mounts `licensed/signalp` to exactly
    // that legacy path to work around it -- this is not a container bug, it just needs the
    // older SignalP version, which DTU still distributes (see issue 9/4 for the corrected
    // writeup; initially mistaken for a Perl/Python incompatibility before this was tried).
    // signalp-4.1g.Linux.tar.gz's top-level `signalp-4.1/{signalp,lib/}` extracted directly
    // to interproscan_db/licensed/signalp/{signalp,lib/} -- exact match for
    // interproscan.properties' binary.signalp.path / signalp.perl.library.dir, no shim
    // needed.
    interpro_licensed_software    = true
}
