// TEMPLATE — current recommended nextflow.config for MAP v5.0.0 (EBI-Metagenomics/mobilome-
// annotation-pipeline) on esrum (SLURM + Singularity). Copy into a new run dir and use with
// `-c nextflow.config -c <path>/my_paths.config` (DB paths: ../assembly_to_MGE/my_paths.config).
// Built up from every run so far: coassembly production (2026-08/09) + matph product, donors and
// dRep catalogue (2026-10). Each override says which run needed it. When a new run needs a new
// override, add it HERE (dated, with the reason) so the next run starts from it.
// Also apply the code patches first (README.md "Patches", 4 + 5) and run
// scripts/check_map_outputs.sh after every run.

process {
    executor      = 'slurm'
    queue         = 'standardqueue'
    clusterOptions = '--account=cbmr'

    // Running 19 samples' worth of tasks concurrently across funcscan+MAP+anvi'o-KEGG at
    // once (production scale-up, 2026-08-29) exhausts the system's Singularity loop devices
    // under load: "failed to find loop device... resource temporarily unavailable" -- a
    // transient infra contention issue, not a real task failure. Retry with backoff instead
    // of letting one transient hit kill the whole 19-sample run; 'finish' (not 'terminate')
    // on final failure lets other samples' in-flight tasks complete instead of being killed too.
    // GENOMAD's own Python wrapper catches mmseqs2's SIGKILL (OOM) itself and re-raises as
    // a plain Exception, so Nextflow only ever sees the wrapper's own exit 1 -- the real
    // signal is invisible at the task level (confirmed via .command.err: "died with
    // <Signals.SIGKILL: 9>" buried inside the Python traceback). Retrying only on
    // 130..145/104/255 missed this entirely (mh_p398/mh_p584 both went straight to
    // 'finish' with no retry). Broadened to include 1 -- accepts retrying some genuinely-
    // broken exit-1 tasks needlessly, an acceptable cost given the alternative is silently
    // dropping OOM'd samples.
    errorStrategy = { task.exitStatus in ([1] + (130..145) + [104, 255]) ? 'retry' : 'finish' }
    maxRetries    = 4

    // Same real-scale concern as funcscan's config (230K-696K genes/participant) -- scale
    // memory up on each retry instead of retrying an OOM identically.
    // NOTE: referencing `task.memory` inside this closure recurses infinitely (Nextflow
    // resolves task.memory BY CALLING this same closure) -- confirmed via a real
    // java.lang.StackOverflowError in funcscan's identical mistake. Fixed base value only.
    withName: '.*' {
        memory = { [16.GB * task.attempt, 128.GB].min() }
    }

    // Upstream bug in MAP v5.0.0: DB_DOWNLOAD_VFDB's script calls `curl`, but its
    // container (depot.galaxyproject.org/singularity/diamond:2.1.16--h13889ed_0) only
    // ships `wget`, not curl -- fails with exit 127 every time. No skip flag exists for
    // this one step of --download_dbs (subworkflows/local/download_databases.nf runs all
    // DB downloads unconditionally). Rather than block the other 8 independent DB
    // downloads on this one broken step, let it fail without halting the run -- we build
    // VFDB_setB_pro.dmnd by hand instead (see README.md) and point --virulencefactors_db
    // at that file directly.
    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_VFDB' {
        errorStrategy = 'ignore'
    }

    // Second upstream bug: DB_DOWNLOAD_MOBILOME_DBS's geNomad tarball downloads and
    // extracts fine (verified: full 842MB, all expected DB files present), but the
    // archive's internal top-level folder is named `genomad_db/`, not `genomad_db_v1.9/`
    // as this process declares -- so Nextflow reports "missing output" despite the task
    // succeeding. Data rescued by hand from the work dir into
    // scratch/mobilome_db/genomad/genomad_db_v1.9 (see README.md); ignore the resulting
    // failure so the rest of --download_dbs completes.
    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_MOBILOME_DBS' {
        errorStrategy = 'ignore'
    }

    // SANNTIS OOM'd (exit 137, "Killed") on all 19 of 19 participants at least once at the
    // blanket cap -- unlike AMPIR/RGI_MAIN/RUNDBCAN in funcscan (which only affected the
    // 2-3 largest participants), this is systemic: SANNTIS just needs meaningfully more
    // baseline memory than the blanket 16GB-start regardless of participant size. Rather
    // than let every participant slowly ramp through 4 retries (16->32->48->64->...GB)
    // before finally getting enough, start it high directly.
    withName: '.*SANNTIS' {
        memory = { [64.GB * task.attempt, 512.GB].min() }
        // Defensive: added preemptively after finding the identical time-vs-memory
        // confusion cost real cycles on both RUNDBCAN (funcscan) and INTERPROSCAN (this
        // config) -- SANNTIS is the same class of tool on the same two giant participants,
        // likely to hit the same default-time-limit wall rather than risk rediscovering it.
        time   = { 24.h * task.attempt }
    }

    // INTERPROSCAN (BGC_ANNOTATION's own IPS run, needed as SANNTIS's prerequisite) OOM'd
    // on mh_p789 (exit 137, "Killed") -- its own script does respect task.memory
    // dynamically (`JAVA_OPTS="-Xmx${task.memory.toGiga()}G"`, confirmed by reading the
    // module directly, not hardcoded), just needed the same higher floor as SANNTIS.
    // Same lesson as funcscan's RUNDBCAN: after the memory fix, mh_p789/mh_p813 still
    // failed (exit 140) -- confirmed via .command.begin/.exitcode timestamps this was a
    // genuine SLURM timeout (ran EXACTLY 20h00m, matching `#SBATCH -t 20:00:00` precisely),
    // not memory. Keep the existing memory override AND add time -- do not drop the memory
    // fix to add time, both constraints are real simultaneously (that mistake cost a full
    // extra resume cycle on funcscan's identical RUNDBCAN case).
    withName: '.*INTERPROSCAN' {
        memory = { [64.GB * task.attempt, 512.GB].min() }
        time   = { 24.h * task.attempt }
    }

    // matph (2026-10): GENOMAD's first attempt at the 16GB blanket failed every time
    // (mmseqs prefilter, OOM hidden as exit 1, see above), peak on retry ~19GB on a 23k-contig
    // catalogue. Start at 32GB instead of burning one attempt per sample.
    withName: '.*GENOMAD' {
        memory = { [32.GB * task.attempt, 256.GB].min() }
    }

    // matph (2026-10): PATHOFACT2_VIRULENCE killed at 16GB (exit 137), peak ~102GB on a 468k-gene
    // catalogue. Start at 128GB.
    withName: '.*PATHOFACT2_VIRULENCE' {
        memory = { [128.GB * task.attempt, 512.GB].min() }
    }

    // InterProScan / SanntiS durations seen in matph: IPS 9-13h per sample (300-400k genes),
    // 17h on a 468k-gene catalogue; SanntiS 4-7h. The 24h x attempt limits above cover this.
}

singularity {
    enabled   = true
    autoMounts = true
    cacheDir  = '/maps/projects/hansen_ol-AUDIT/scratch/singularity_cache'
}

executor {
    // Same throttle issue as funcscan's config -- 50 was copied from the tiny 2-sample
    // test configs, well below real capacity at 19-participant scale. Executor-level
    // setting only, doesn't affect the resume cache hash.
    queueSize = 200
}

// Native SignalP6 module (patched into the MAP asset checkout earlier this session) is not
// used going forward -- see CLAUDE.md "SignalP / export prediction: use the MAP/IPS route,
// not the custom build". Just needs a default so the still-present `if (params.
// run_native_signalp)` guard in the patched subworkflow doesn't hard-error on an undefined param.
params {
    run_native_signalp = false

    // Nextflow self-update earlier this session (25.10.2 -> 26.04.6, needed for funcscan
    // 4.0.0's version floor) broke MAP's own CLI boolean parsing: `--skip_gecco true` on the
    // command line now validates as [string] not [boolean] ("Validation of pipeline
    // parameters failed"). Setting them directly as real Groovy booleans here instead
    // sidesteps the CLI parser entirely -- drop the --skip_* flags from the launch command.
    skip_sanntis   = false
    skip_gecco     = true
    skip_antismash = true
}
