// Slurm + Singularity config for nf-core/funcscan on the esrum cluster. Same
// account/queue/singularity cache convention as ../nextflow.config -- see that file for
// why. No process-level workarounds here yet; add them if/when funcscan hits its own bugs
// (document in README.md the same way ../ documents MAP's).

process {
    executor       = 'slurm'
    queue          = 'standardqueue'
    clusterOptions = '--account=cbmr'

    // Running 19 samples concurrently across funcscan+MAP+anvi'o-KEGG (production
    // scale-up, 2026-08-29) can exhaust the system's Singularity loop devices under load:
    // "failed to find loop device... resource temporarily unavailable" -- transient infra
    // contention (hit this in MAP's run), not a real task failure. Retry with backoff
    // instead of letting one transient hit kill the whole 19-sample run.
    // MAP's GENOMAD step showed some tools' own wrappers catch a SIGKILL (OOM) themselves
    // and re-raise as a plain exit 1, hiding the real signal from Nextflow entirely --
    // retrying only on 130..145/104/255 missed it completely. Broadened to include 1;
    // accepts retrying some genuinely-broken exit-1 tasks needlessly, an acceptable cost
    // given the alternative is silently dropping OOM'd samples.
    errorStrategy = { task.exitStatus in ([1] + (130..145) + [104, 255]) ? 'retry' : 'finish' }
    maxRetries    = 4

    // Real per-participant scale here (230K-696K genes) is 15-55x the curated subset
    // funcscan's own resource labels were never tuned against -- hit an actual OOM (exit
    // 137, "status = 35072" from AMRFinderPlus's tblastn on mh_p813, the largest
    // participant), not just a transient container blip. Scale memory up on each retry
    // instead of retrying identically and OOMing again.
    // NOTE: referencing `task.memory` inside this closure (to mean "whatever the process
    // already had") is a real, confirmed trap -- Nextflow resolves task.memory BY CALLING
    // this same closure, so self-referencing it recurses infinitely (hit a real
    // java.lang.StackOverflowError this way, aborting the whole run). Use a fixed base
    // value instead, never task.memory, in any per-attempt scaling directive.
    withName: '.*' {
        memory = { [16.GB * task.attempt, 128.GB].min() }
    }

    // AMPIR (R's ampir package) genuinely needs more than the 128GB blanket cap on the
    // 3 largest participants (mh_p523/mh_p789/mh_p813, 435K-696K genes) -- confirmed real
    // OOM (exit 137) even after exhausting all 4 retries at the capped ceiling, not a
    // transient issue. Node capacity here is ~2TB, so this has real headroom. A more
    // specific withName selector placed after the blanket '.*' one above overrides memory
    // for AMPIR only -- doesn't touch any other process's resolved config/cache hash.
    withName: '.*AMPIR' {
        memory = { [32.GB * task.attempt, 512.GB].min() }
    }

    // AMPCOMBI2_CLUSTER's cross-sample AMP dedup needs real per-participant GBK content we
    // deliberately didn't build for this production run (see README.md) -- this failure is
    // known and accepted, not something to chase. But its default errorStrategy ('finish')
    // still triggered "Killing running tasks" for everything ELSE still in flight (60 tasks
    // killed the first time this ran, including RGI_MAIN for effectively all 19
    // participants, mid-execution, real AMR work that would have completed fine on its
    // own). Explicit 'ignore' here stops this one known limitation from taking the whole
    // run down with it.
    withName: '.*AMPCOMBI2_CLUSTER' {
        errorStrategy = 'ignore'
    }

    // RGI_MAIN failed (exit 140) on 8+ different participants at the blanket 128GB cap,
    // despite real, complete output already written (mh_p341.json 9.5MB, mh_p341.txt
    // 1.2MB, both look legitimate) before the task's own exit status came back non-zero --
    // consistent with a resource limit hit late (post-processing/cleanup/a lingering
    // multiprocessing worker), not a data/logic failure, at only 16GB requested for the
    // first attempt. (Also produces repeated non-fatal "Requested rname X does not exist"
    // warnings from its own partial-hit boundary refinement -- traced to pyfaidx via the
    // container's own site-packages; harmless noise, real output unaffected, not the cause
    // of the exit 140.) Same fix pattern as AMPIR above.
    withName: '.*RGI_MAIN' {
        memory = { [32.GB * task.attempt, 512.GB].min() }
    }

    // Same pattern again: RUNDBCAN's three steps (EASYCGC/EASYSUBSTRATE/CAZYMEANNOTATION)
    // OOM'd (exit 137/140, "Killed") at the 128GB blanket cap, only on the two largest
    // participants (mh_p789/mh_p813, 667K/696K genes) -- everything else in the run
    // completed successfully at this point. Still failed at 32GB after a fresh -resume:
    // task.attempt does not appear to carry over across separate `-resume` invocations
    // (each fresh nextflow process seems to restart its own attempt counter at 1) -- so
    // repeatedly resuming would keep requesting only 32GB forever, never actually
    // escalating. Same fix as SANNTIS: start high directly instead of relying on
    // per-attempt ramping across resumes.
    withName: '.*RUNDBCAN.*' {
        memory = { [256.GB * task.attempt, 512.GB].min() }
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/maps/projects/hansen_ol-AUDIT/scratch/singularity_cache'
}

executor {
    // 50 was copied from the tiny 2-sample curated-subset test configs -- at real
    // 19-participant production scale (each sample alone spawns ~10 parallel fARGene
    // sub-tasks, plus AMPIR/ABRicate/AMRFinderPlus/RGI/DeepARG/dbCAN etc.), this throttled
    // us well below actual cluster capacity: confirmed 330 idle CPUs + one fully idle node
    // while our own jobs sat capped at 50. This is an executor-level submission-throttle
    // setting, not a per-task directive -- doesn't affect the resume cache hash, safe to
    // change and resume freely.
    queueSize = 200
}
