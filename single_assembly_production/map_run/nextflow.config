// Slurm + Singularity config for MAP on the esrum cluster, single-sample production
// (277 groups). Copied from ../../coassembly_production/map_run/nextflow.config --
// reusing every fix already proven there rather than re-discovering them at this scale
// too. See that file's comments for the full story behind each one; not repeated here.

process {
    executor      = 'slurm'
    queue         = 'standardqueue'
    clusterOptions = '--account=cbmr'

    errorStrategy = { task.exitStatus in ([1] + (130..145) + [104, 255]) ? 'retry' : 'finish' }
    maxRetries    = 4

    withName: '.*' {
        memory = { [16.GB * task.attempt, 128.GB].min() }
    }

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_VFDB' {
        errorStrategy = 'ignore'
    }

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_MOBILOME_DBS' {
        errorStrategy = 'ignore'
    }

    // Kept defensively even though single-sample groups are individually smaller
    // (132K-321K genes vs co-assembly's 230K-696K) -- a targeted override that never
    // triggers costs nothing, and re-discovering this per group would.
    withName: '.*SANNTIS' {
        memory = { [64.GB * task.attempt, 512.GB].min() }
        time   = { 24.h * task.attempt }
    }

    withName: '.*INTERPROSCAN' {
        memory = { [64.GB * task.attempt, 512.GB].min() }
        time   = { 24.h * task.attempt }
    }
}

singularity {
    enabled   = true
    autoMounts = true
    cacheDir  = '/maps/projects/hansen_ol-AUDIT/scratch/singularity_cache'
}

executor {
    // Trimmed from the co-assembly run's 200 -- this run shares the cluster with the
    // still-running single-sample anvi'o-KEGG array (kofams, %20) and the gene-export
    // array (%40) at the same time, on top of its own 277-group scope. More considerate
    // ceiling given the real concurrent load already in flight.
    queueSize = 100
}

params {
    run_native_signalp = false
    skip_sanntis   = false
    skip_gecco     = true
    skip_antismash = true
}
